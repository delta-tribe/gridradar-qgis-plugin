{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to QGIS",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder:gridradar_qgis_plugin}",
          "remoteRoot": "${env:HOME}/.local/share/QGIS/QGIS3/profiles/default/python/plugins/gridradar_qgis_plugin"
        }
      ],
      "justMyCode": false
    }
  ]
}
